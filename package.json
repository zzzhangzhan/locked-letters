{
  "name": "locked-letters",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && concurrently -n api,web -c blue,green \"wrangler dev --port 8787\" \"vite --port 5173\"",
    "build": "vite build",
    "db:local": "wrangler d1 migrations apply locked-letters --local",
    "db:remote": "wrangler d1 migrations apply locked-letters --remote",
    "start": "NODE_ENV=production node server/index.js",
    "deploy:cloudflare": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "express": "^4.22.3",
    "multer": "^2.5.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.2.0",
    "wrangler": "4.86.0"
  }
}
